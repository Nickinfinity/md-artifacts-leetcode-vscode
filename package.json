{
  "name": "md-artifacts-leetcode-vscode",
  "displayName": "MD Artifacts: AI LeetCode Trainer",
  "description": "Turn type: leetcode notes in your Obsidian vault into runnable coding challenges with auto-generated boilerplate, a per-language test harness, and a child-process test runner.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": [
    "Education",
    "Testing",
    "Other"
  ],
  "keywords": [
    "leetcode",
    "obsidian",
    "coding practice",
    "interview prep",
    "algorithms"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "md-leetcode.settings",
        "category": "MD Artifacts",
        "title": "Settings"
      },
      {
        "command": "md-leetcode.create",
        "category": "MD Artifacts",
        "title": "Create LeetCode Exercise"
      },
      {
        "command": "md-leetcode.open",
        "category": "MD Artifacts",
        "title": "Open LeetCode Exercise",
        "icon": "$(beaker)"
      },
      {
        "command": "md-leetcode.endChallenge",
        "category": "MD Artifacts",
        "title": "End LeetCode Challenge"
      }
    ],
    "submenus": [
      {
        "id": "md-leetcode.contextMenu",
        "label": "MD Artifacts"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "md-leetcode",
          "title": "MD Artifacts: LeetCode",
          "icon": "resources/leetcode.svg"
        }
      ]
    },
    "views": {
      "md-leetcode": [
        {
          "id": "md-leetcode.view",
          "name": "LeetCode",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "submenu": "md-leetcode.contextMenu",
          "group": "mda@1"
        }
      ],
      "md-leetcode.contextMenu": [
        {
          "command": "md-leetcode.settings",
          "group": "mda@1"
        },
        {
          "command": "md-leetcode.create",
          "group": "mda@2"
        }
      ],
      "commandPalette": [
        {
          "command": "md-leetcode.open",
          "when": "md-leetcode.vaultConfigured"
        }
      ],
      "view/title": [
        {
          "command": "md-leetcode.open",
          "when": "view == md-leetcode.view && md-leetcode.vaultConfigured",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.6.0",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3"
  }
}
